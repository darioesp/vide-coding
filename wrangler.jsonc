{
  "name": "vibe-coding",
  "compatibility_date": "2026-03-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./main.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": "./static"
  },
  "routes": [
    {
      "pattern": "vibe-coding.daes.dev",
      "custom_domain": true
    }
  ]
}
