{
  "name": "vibe-coding",
  "main": "./server.ts",
  "compatibility_date": "2026-03-29",
  "assets": {
    "binding": "ASSETS",
    "directory": "./static"
  },
  "routes": [
    {
      "pattern": "vibe-coding.daes.dev",
      "custom_domain": true
    }
  ],
  "alias": {
    "$fresh/": "https://deno.land/x/fresh@1.7.3/",
    "preact": "https://esm.sh/preact@10.22.0",
    "preact/": "https://esm.sh/preact@10.22.0/"
  }
}
